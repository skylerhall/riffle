// Grover search that marks its answer through a scratch qubit.
// `work(scratch)` declares a work qubit: it starts at |0>, and Riffle
// cleans it up automatically right after its last use.
circuit grover_work(q0, q1) work(scratch) {
    s0 = H q0
    s1 = H q1

    a0, a1, both = CCX s0, s1, scratch    // scratch = q0 AND q1
    marked       = Z both                 // flip the sign of |11> through it
                                          // (Riffle adds the undo here)
    h0 = H a0
    h1 = H a1
    x0 = X h0
    x1 = X h1
    m0, m1 = CZ x0, x1
    u0 = X m0
    u1 = X m1
    out0 = H u0
    out1 = H u1
}

// The same circuit with cleanup switched off: the leftover scratch
// value spoils the interference and the answer drops to 62.5%.
circuit grover_no_cleanup(q0, q1) work(scratch) {
    cleanup off
    s0 = H q0
    s1 = H q1
    a0, a1, both = CCX s0, s1, scratch
    marked       = Z both
    h0 = H a0
    h1 = H a1
    x0 = X h0
    x1 = X h1
    m0, m1 = CZ x0, x1
    u0 = X m0
    u1 = X m1
    out0 = H u0
    out1 = H u1
}
